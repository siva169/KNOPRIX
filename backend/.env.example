# Required in production
JWT_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-another-long-random-value
CORS_ORIGINS=https://your-frontend-domain.example
FIREBASE_PROJECT_ID=knoprix-a647
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require

# Supabase Storage (native REST API — keep the key server-side in Render)
OBJECT_STORAGE_BUCKET=knoprix-documents
OBJECT_STORAGE_ENDPOINT=https://<project-ref>.supabase.co
OBJECT_STORAGE_API_KEY=replace-with-supabase-service-role-secret

# Optional
PORT=8000
MAX_UPLOAD_MB=500

# Optional local-only demo data; never enable in hosted environments.
# ENABLE_DEMO_SEED=true
# DEMO_PASSWORD=choose-a-private-local-password

# Optional AI provider keys. Configure only the providers you intend to use.
# Keep real values in backend/.env or the deployment's secret manager.
# GLM_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=  # Both are accepted; GOOGLE_API_KEY takes precedence.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# NVIDIA NIM uses a shared backend-managed key; never put the real value in source control.
# NVIDIA_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# SARVAM_API_KEY=  # Optional shared deployment key; users may also provide BYOK.
# DEFAULT_AI_PROVIDER=zai-glm-free
# DEFAULT_AI_MODEL=glm-4.5-flash
