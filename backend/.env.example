# Required in production
JWT_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-another-long-random-value
CORS_ORIGINS=https://your-frontend-domain.example
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Supabase Storage S3 connection (keep these values server-side in Render)
OBJECT_STORAGE_BUCKET=knoprix-documents
OBJECT_STORAGE_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
OBJECT_STORAGE_ACCESS_KEY=replace-with-supabase-s3-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-supabase-s3-secret-key
OBJECT_STORAGE_REGION=ap-northeast-1

# Optional
PORT=8000
MAX_UPLOAD_MB=500
