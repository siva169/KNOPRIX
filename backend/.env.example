# Required in production
JWT_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-another-long-random-value
CORS_ORIGINS=https://your-frontend-domain.example
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Supabase Storage (native REST API — keep the key server-side in Render)
OBJECT_STORAGE_BUCKET=knoprix-documents
OBJECT_STORAGE_ENDPOINT=https://<project-ref>.supabase.co
OBJECT_STORAGE_API_KEY=replace-with-supabase-service-role-secret

# Optional
PORT=8000
MAX_UPLOAD_MB=500
