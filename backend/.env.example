# Required in production
JWT_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-another-long-random-value
CORS_ORIGINS=https://your-frontend-domain.example
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Cloudflare R2 (S3-compatible object storage)
OBJECT_STORAGE_BUCKET=knoprix-documents
OBJECT_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY=replace-with-r2-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-r2-secret-key
OBJECT_STORAGE_REGION=auto

# Optional
PORT=8000
MAX_UPLOAD_MB=500
